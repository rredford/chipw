; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
AppName=Chip's Workshop
AppVersion=2.0.7
AppVerName=Chip's Workshop 2.0.7
AppPublisher=Christopher Elsby
AppCopyright=Copyright 2008-2011,2021 Christopher Elsby
AppPublisherURL=https://www.microstupidity.com/chipw/
AppSupportURL=https://www.microstupidity.com/chipw/
AppUpdatesURL=https://www.microstupidity.com/chipw/
VersionInfoVersion=2.0.7
VersionInfoTextVersion=2.0.7
DefaultDirName={pf}\ChipW
DefaultGroupName=Chip's Workshop
AllowNoIcons=yes
OutputDir=H:\chipw
OutputBaseFilename=chipw-win32-setup
Compression=lzma
SolidCompression=yes
TimeStampsInUTC=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "H:\chipw\win32-build\chipw.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "H:\chipw\data\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "H:\chipw\doc\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "H:\chipw\win32-dlls\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{group}\Chip's Workshop"; Filename: "{app}\chipw.exe"; WorkingDir: "{app}"
Name: "{group}\User's manual"; Filename: "{app}\chipw.html"
Name: "{group}\{cm:ProgramOnTheWeb,Chip's Workshop}"; Filename: "https://www.microstupidity.com/chipw/"
Name: "{group}\{cm:UninstallProgram,Chip's Workshop}"; Filename: "{uninstallexe}"
Name: "{commondesktop}\Chip's Workshop"; Filename: "{app}\chipw.exe"; WorkingDir: "{app}"; Tasks: desktopicon

